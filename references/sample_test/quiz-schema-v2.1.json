{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nojam.com/schemas/quiz-v2.1.json",
  "title": "Quiz Configuration Schema v2.1",
  "description": "JSON-driven 심리테스트 설정 스키마 (단순화 버전)",
  "type": "object",
  "required": ["meta", "config", "questions", "results"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema 참조"
    },
    "meta": {
      "type": "object",
      "description": "테스트 메타데이터",
      "required": ["id", "title", "description", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$",
          "description": "테스트 고유 ID (소문자, 숫자, 언더스코어, 하이픈만 허용)"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "테스트 제목"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "테스트 설명"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "버전 (시맨틱 버저닝)"
        },
        "author": {
          "type": "string",
          "description": "작성자"
        },
        "created_at": {
          "type": "string",
          "format": "date",
          "description": "생성일 (YYYY-MM-DD)"
        },
        "estimated_time": {
          "type": "string",
          "description": "예상 소요 시간"
        },
        "target_age": {
          "type": "string",
          "description": "대상 연령"
        }
      }
    },
    "config": {
      "type": "object",
      "description": "테스트 설정",
      "required": ["question_count", "result_types", "scoring_method"],
      "properties": {
        "question_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "문항 수"
        },
        "result_types": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20,
          "description": "결과 유형 수"
        },
        "scoring_method": {
          "type": "string",
          "enum": ["simple_count", "weighted_sum", "percentage"],
          "description": "점수 계산 방식"
        },
        "randomize_questions": {
          "type": "boolean",
          "default": false,
          "description": "문항 순서 랜덤화"
        },
        "show_progress": {
          "type": "boolean",
          "default": true,
          "description": "진행률 표시"
        }
      }
    },
    "questions": {
      "type": "array",
      "description": "문항 목록",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "type", "choices"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^q\\d+$",
            "description": "문항 ID (q1, q2, ... 형식)"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "문항 텍스트"
          },
          "type": {
            "type": "string",
            "enum": ["single_choice", "multiple_choice", "slider", "ranking"],
            "description": "문항 유형"
          },
          "choices": {
            "type": "array",
            "description": "선택지 목록",
            "minItems": 2,
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": ["id", "text", "result_type"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^q\\d+_[a-z]$",
                  "description": "선택지 ID (q1_a, q1_b, ... 형식)"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "description": "선택지 텍스트"
                },
                "result_type": {
                  "type": "string",
                  "pattern": "^[A-Z0-9_]+$",
                  "description": "해당 선택지가 가리키는 결과 유형"
                }
              }
            }
          }
        }
      }
    },
    "results": {
      "type": "object",
      "description": "결과 유형 정의",
      "minProperties": 2,
      "patternProperties": {
        "^[A-Z0-9_]+$": {
          "type": "object",
          "required": ["code", "title", "subtitle", "description", "keywords", "quote", "emoji", "style"],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$",
              "description": "결과 유형 코드"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50,
              "description": "결과 제목"
            },
            "subtitle": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "결과 부제목"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "description": "결과 설명"
            },
            "keywords": {
              "type": "array",
              "description": "대표 키워드",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              }
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "대표 대사"
            },
            "emoji": {
              "type": "string",
              "pattern": "^[\\p{Emoji}\\p{Emoji_Modifier}\\p{Emoji_Component}\\p{Emoji_Modifier_Base}\\p{Emoji_Presentation}\\p{Extended_Pictographic}]+$",
              "description": "대표 이모지"
            },
            "style": {
              "type": "object",
              "description": "카드 스타일 정보",
              "required": ["gradient", "number", "css_class"],
              "properties": {
                "gradient": {
                  "type": "string",
                  "pattern": "^linear-gradient\\(",
                  "description": "CSS 그라데이션"
                },
                "number": {
                  "type": "string",
                  "pattern": "^[①②③④⑤⑥⑦⑧⑨⑩]$",
                  "description": "원형 숫자"
                },
                "css_class": {
                  "type": "string",
                  "pattern": "^type-\\d+$",
                  "description": "CSS 클래스명"
                }
              }
            },
            "share": {
              "type": "object",
              "description": "공유 정보",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "description": "공유 제목"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "공유 설명"
                },
                "hashtags": {
                  "type": "array",
                  "description": "해시태그",
                  "items": {
                    "type": "string",
                    "pattern": "^#[가-힣a-zA-Z0-9_]+$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "analytics": {
      "type": "object",
      "description": "분석 설정",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "분석 활성화"
        },
        "events": {
          "type": "array",
          "description": "추적할 이벤트",
          "items": {
            "type": "string",
            "enum": ["quiz_started", "question_answered", "quiz_completed", "result_shared"]
          }
        }
      }
    }
  }
} 